<Project>

  <ItemGroup>
    <!-- Microsoft.Data.SqlClient 6.1.1 (via Microsoft.EntityFrameworkCore.SqlServer) traz
         System.Security.Cryptography.Pkcs 9.0.4, que tem vulnerabilidades conhecidas
         (GHSA-846f-f764-76mx / alta e GHSA-2fmv-rv2c-59x7 / moderada).
         Referencia direta eleva a versao resolvida para a primeira corrigida da banda 10.x.
         Pode ser removido quando o SqlClient passar a depender de uma versao >= 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
